# Copy to .env.local for local development — never commit .env.local

# ── NextAuth (Auth.js v5) ───────────────────────────────────────────
# Secret used to sign the session JWT.
AUTH_SECRET=
# Google OAuth provider (Sign in with Google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Admin dashboard (/admin) ────────────────────────────────────────
# Comma-separated allowlist of emails that may access /admin.
# Example: you@studentcentral.ai, teammate@studentcentral.ai
ADMIN_EMAILS=

# ── Analytics pipeline (/api/track, /api/visit → Sheets) ────────────
# Google Apps Script web-app URL that appends POSTed rows to the Sheet.
APPS_SCRIPT_URL=
# The Google Sheet the dashboard reads back from, with Leads / Visits (/ Events) tabs.
GOOGLE_SHEETS_ID=
# Service account with read access to that Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional analytics exclusions (comma-separated), in addition to the
# internal-traffic cookie set when an admin browses /admin.
EXCLUDED_EMAILS=
EXCLUDED_READER_IDS=
