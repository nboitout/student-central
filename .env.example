# ── Access monitoring (admin dashboard at /admin) ──────────────────────────
# Password for the /admin/login page (sets the admin_session cookie).
ADMIN_PASSWORD=

# Google Sheet that stores the access logs, and the service account used to
# read it back for the dashboard (Sheets API enabled; share the sheet as Viewer
# with GOOGLE_SERVICE_ACCOUNT_EMAIL).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Apps Script web-app /exec URL that appends rows to the sheet
# (see docs/apps-script.gs).
APPS_SCRIPT_URL=

# Optional: hide your own traffic from the dashboard. Comma-separated.
EXCLUDED_EMAILS=
EXCLUDED_READER_IDS=

# ── Existing auth (NextAuth / Google OAuth) ────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
