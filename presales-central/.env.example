# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Allowed rep emails (comma-separated); leave blank to allow any valid email
ALLOWED_EMAILS=you@yourcompany.com

# Vercel Postgres — auto-populated when you add Vercel Postgres in the dashboard
POSTGRES_URL=

# Vercel Blob — auto-populated when you add Vercel Blob in the dashboard
BLOB_READ_WRITE_TOKEN=
